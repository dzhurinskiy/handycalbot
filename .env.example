# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Database
DATABASE_URL=postgresql+asyncpg://calendarbot:calendarbot@localhost:5432/calendarbot

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
